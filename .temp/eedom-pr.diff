+        if let title, !title.isEmpty {
+            displayTitle = title
+        } else {
+            let formatter = DateFormatter()
+            formatter.dateStyle = .medium
+            formatter.timeStyle = .short
+            displayTitle = formatter.string(from: date)
+        }
+        return "# Meeting Notes: \(displayTitle)\n\n"
+    }
