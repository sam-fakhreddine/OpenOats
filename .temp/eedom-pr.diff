+        case .denied, .restricted:
+            VStack(spacing: 8) {
+                Text("Microphone access was previously denied. OpenOats needs it to transcribe.")
+                    .font(.system(size: 12))
+                    .foregroundStyle(.secondary)
+                    .multilineTextAlignment(.center)
