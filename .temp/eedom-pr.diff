+                AVFormatIDKey: kAudioFormatMPEG4AAC,
+                AVSampleRateKey: targetRate,
+                AVNumberOfChannelsKey: 1,
+                AVEncoderBitRateKey: 128_000,
+            ],
+            commonFormat: .pcmFormatFloat32,
+            interleaved: false
+        ) else {
+            Log.recorder.error("Failed to create output file")
+            return
+        }
