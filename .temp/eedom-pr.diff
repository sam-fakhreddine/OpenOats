+    public init(
+        sessionID: SessionID,
+        fileURL: URL,
+        location: AudioStorageLocation,
+        createdAt: Date = Date(),
+        updatedAt: Date = Date(),
+        state: RecordingState
+    ) {
+        self.sessionID = sessionID
