+
+    /// Seconds between consecutive suggestions.
+    var cooldownSeconds: TimeInterval {
+        switch self {
+        case .quiet: 90
+        case .balanced: 45
+        case .eager: 15
+        }
+    }
+
+    /// Multiplier applied to gate score thresholds. Lower = easier to surface.
+    var thresholdMultiplier: Double {
