+            MarkdownMeetingWriter.formatRelativeTimestamp(later, relativeTo: start),
+            "00:01:05"
+        )
+    }
+
+    func testRelativeTimestampOverOneHour() {
+        let start = Date()
+        let later = start.addingTimeInterval(3661) // 1 hour, 1 min, 1 sec
+        XCTAssertEqual(
+            MarkdownMeetingWriter.formatRelativeTimestamp(later, relativeTo: start),
