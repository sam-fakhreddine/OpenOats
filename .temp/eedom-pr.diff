+enum NotesFolderColor: String, CaseIterable, Identifiable, Codable {
+    case gray
+    case orange
+    case gold
+    case purple
+    case blue
+    case teal
+    case green
+    case red
+
+    var id: String { rawValue }
+
+    var displayName: String {
+        rawValue.capitalized
+    }
