+        let canAcceptDrop = state.notesGenerationStatus != .generating && state.selectedSessionID != nil
+
+        return Group {
+            if canAcceptDrop {
+                content()
+                    .contentShape(Rectangle())
+                    .onDrop(
+                        of: notesAssetDropTypeIdentifiers,
+                        isTargeted: $isNotesAssetDropTarget
+                    ) { providers in
