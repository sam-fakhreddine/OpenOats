{
  "name": "@openoats/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for OpenOats TDD Orchestration",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "mcp": {
    "tools": [
      "generate_prompt",
      "create_worktree",
      "run_phase",
      "validate_output",
      "get_task_info"
    ],
    "resources": [
      "prompts://master",
      "prompts://components/{type}/{id}",
      "tasks://{epic}/{task_id}",
      "schemas://{schema_name}"
    ]
  }
}